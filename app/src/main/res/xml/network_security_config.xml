<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Most IPTV/Xtream panels are served over plain HTTP on custom ports. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
